{
  "task": "亮度区域二分类(0=无高亮,1=有高亮)",
  "pipeline": "图像 -> 预处理 -> 特征提取 -> 特征向量 -> 分类器训练 -> 预测",
  "libraries": [
    "opencv-python(cv2)",
    "numpy",
    "pandas",
    "scikit-learn"
  ],
  "preprocess": {
    "image_size": [
      224,
      224
    ],
    "gray": true,
    "keep_rgb_features": true,
    "bright_threshold": 200
  },
  "feature_columns": [
    "brightness_mean",
    "brightness_std",
    "brightness_max",
    "brightness_min",
    "brightness_p95",
    "block_mean_var",
    "block_mean_max",
    "block_mean_min",
    "block_top3_mean",
    "bright_block_count",
    "bright_pixel_ratio",
    "connected_component_count",
    "largest_component_area",
    "largest_component_ratio",
    "sobel_mean",
    "laplacian_var",
    "rgb_r_mean",
    "rgb_g_mean",
    "rgb_b_mean"
  ],
  "train_test_split": {
    "test_size": 0.2,
    "seed": 42,
    "stratify": true,
    "train_samples": 312,
    "test_samples": 79
  },
